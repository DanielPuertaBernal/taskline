#!/usr/bin/env bash
# Taskline auto-update for Omarchy.
#
# Started (detached) by the danso.tasks plugin when it loads. Checks the latest
# GitHub release at most once a day; when it is newer than the installed
# plugin, downloads taskline-omarchy.tar.gz, verifies its SHA256 against the
# release's SHA256SUMS.txt and runs the packaged install.sh, which backs up
# what it changes and is idempotent. Tasks are never touched: they live in
# Taskwarrior's data.location, which install.sh does not write.
#
# Usage:
#   taskline-update           check now (ignores the once-a-day limit and the opt-out)
#   taskline-update --auto    what the plugin runs: honours the limit and the opt-out
#
# Opt out: put `auto_update=false` in ~/.config/taskline/omarchy.conf
# (or set TASKLINE_AUTO_UPDATE=0).
#
# Environment (for tests): TASKLINE_API_URL, TASKLINE_UPDATE_NO_RELOAD=1,
# TASKLINE_NO_IPC=1 (passed to install.sh), TASKLINE_MANIFEST.

set -uo pipefail

REPO="DanielPuertaBernal/taskline"
API_URL="${TASKLINE_API_URL:-https://api.github.com/repos/$REPO/releases/latest}"
TARBALL="taskline-omarchy.tar.gz"
SUMS="SHA256SUMS.txt"
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
MANIFEST="${TASKLINE_MANIFEST:-$HERE/manifest.json}"
CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/taskline/omarchy.conf"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/taskline"
STAMP_FILE="$STATE/last-update-check"
LOG="$STATE/update.log"

auto=0
[[ ${1:-} == --auto ]] && auto=1

mkdir -p "$STATE"
log() { printf '%s %s\n' "$(date '+%F %T')" "$*" >>"$LOG"; }
say() { log "$*"; (( auto )) || printf '%s\n' "$*"; }
notify() { command -v notify-send >/dev/null && notify-send -a Taskline "$@" >/dev/null 2>&1 || true; }

opted_out() {
  [[ ${TASKLINE_AUTO_UPDATE:-1} == 0 ]] && return 0
  [[ -f $CONFIG ]] && grep -qiE '^[[:space:]]*auto_update[[:space:]]*=[[:space:]]*(false|0|no|off)[[:space:]]*$' "$CONFIG"
}

# newer <a> <b>: true when version a > b (both X.Y.Z).
newer() { [[ $1 != "$2" && $(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -n1) == "$1" ]]; }

if (( auto )); then
  if opted_out; then log "auto-update disabled ($CONFIG)"; exit 0; fi
  [[ $(cat "$STAMP_FILE" 2>/dev/null) == "$(date +%F)" ]] && exit 0
fi

# One run at a time (the plugin can be loaded on several reloads).
exec 9>"$STATE/update.lock"
command -v flock >/dev/null && { flock -n 9 || exit 0; }

for cmd in curl jq sha256sum tar; do
  command -v "$cmd" >/dev/null || { say "taskline-update: $cmd is missing"; exit 0; }
done

current="$(jq -r '.version // empty' "$MANIFEST" 2>/dev/null)"
[[ $current =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || { say "cannot read the installed version from $MANIFEST"; exit 0; }

# Offline, rate limited or GitHub down: stay quiet and try again next time.
release="$(curl -fsSL --max-time 20 -H 'Accept: application/vnd.github+json' "$API_URL" 2>/dev/null)" || {
  log "could not reach $API_URL"; exit 0; }
date +%F >"$STAMP_FILE"

tag="$(jq -r 'if (.draft or .prerelease) then empty else .tag_name // empty end' <<<"$release" 2>/dev/null)"
latest="${tag#v}"
[[ $latest =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || { log "no usable release tag in API reply"; exit 0; }
if ! newer "$latest" "$current"; then
  say "Taskline $current is up to date (latest: $latest)"
  exit 0
fi

asset_url() { jq -r --arg n "$1" '.assets[]? | select(.name == $n) | .browser_download_url' <<<"$release" | head -n1; }
tar_url="$(asset_url "$TARBALL")"
sums_url="$(asset_url "$SUMS")"
if [[ -z $tar_url || -z $sums_url ]]; then
  say "release $tag has no $TARBALL or $SUMS; not updating"
  exit 0
fi

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT
if ! curl -fsSL --max-time 120 -o "$work/$SUMS" "$sums_url" || ! curl -fsSL --max-time 300 -o "$work/$TARBALL" "$tar_url"; then
  say "download of $tag failed; not updating"
  exit 0
fi

expected="$(awk -v n="$TARBALL" '{f=$2; sub(/^\*/, "", f)} f == n {print tolower($1); exit}' "$work/$SUMS")"
actual="$(sha256sum "$work/$TARBALL" | awk '{print $1}')"
if [[ ! $expected =~ ^[0-9a-f]{64}$ || $expected != "$actual" ]]; then
  say "checksum mismatch for $TARBALL $tag (expected ${expected:-none}, got $actual); NOT installing"
  notify -u critical "Taskline" "La actualización $tag no pasó la verificación SHA256 y no se instaló."
  exit 1
fi

mkdir -p "$work/src"
tar -xzf "$work/$TARBALL" -C "$work/src" || { say "could not extract $TARBALL"; exit 1; }
installer="$(find "$work/src" -maxdepth 2 -name install.sh -print -quit)"
[[ -n $installer ]] || { say "$TARBALL has no install.sh"; exit 1; }
src="$(dirname "$installer")"

log "installing $tag over $current"
# TASKLINE_NO_IPC keeps install.sh from reloading the shell; we do it below,
# once, after everything is in place.
if ! TASKLINE_SRC="$src" TASKLINE_NO_IPC=1 bash "$installer" </dev/null >>"$LOG" 2>&1; then
  say "install.sh from $tag failed; see $LOG"
  notify -u critical "Taskline" "No se pudo instalar la actualización $tag. Detalles en $LOG"
  exit 1
fi

say "Taskline updated to $latest"
notify "Taskline" "Actualizado a v$latest"
# A plugin rescan does not reload a running service's code, so restart the
# shell (it refuses while the session is locked; then fall back to a rescan
# and the new code loads on the next login).
if [[ ${TASKLINE_UPDATE_NO_RELOAD:-0} != 1 && ${TASKLINE_NO_IPC:-0} != 1 ]]; then
  if command -v omarchy-restart-shell >/dev/null && omarchy-restart-shell >>"$LOG" 2>&1; then
    log "shell restarted"
  elif command -v omarchy-shell >/dev/null; then
    omarchy-shell shell rescanPlugins >/dev/null 2>&1 || true
  fi
fi
exit 0
